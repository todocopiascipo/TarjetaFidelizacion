# Plantilla de variables de entorno (SIN valores reales).
# Copiala como .env.local y completá los valores. .env.local nunca se sube a GitHub.

# Supabase → botón "Connect" o Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (empieza con sb_publishable_)
# Es pública: puede usarse en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → Secret key (empieza con sb_secret_)
# Reemplaza a la vieja "service_role". SOLO servidor. Nunca en el navegador ni en GitHub.
SUPABASE_SECRET_KEY=

# Token personal de Supabase para aplicar migraciones desde la terminal (supabase db push).
# Supabase → foto de perfil → Account preferences → Access Tokens. SOLO en tu compu, nunca en Vercel.
SUPABASE_ACCESS_TOKEN=

# Usuarios internos que crea `npm run crear:usuarios`.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Contraseña compartida de los usuarios de prueba (dueno@valisburger.test, cajero@valisburger.test, ...)
PASSWORD_PRUEBA=
